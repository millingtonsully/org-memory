{
  "$comment": "POST /v1/procedural-memories request body.",
  "type": "object",
  "required": ["agent_id", "run_id", "procedure_key", "objective", "events"],
  "properties": {
    "agent_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "procedure_key": {"type": "string", "minLength": 1, "maxLength": 500},
    "objective": {"type": "string", "minLength": 1, "maxLength": 10000},
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["actor", "action", "result"],
        "properties": {
          "actor": {"type": "string", "minLength": 1, "maxLength": 200},
          "action": {"type": "string", "minLength": 1, "maxLength": 20000},
          "result": {"type": "string", "minLength": 1, "maxLength": 40000},
          "metadata": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": false
      }
    },
    "evidence_doc_ids": {
      "type": "array",
      "maxItems": 500,
      "items": {"type": "string"},
      "default": []
    },
    "org_visible": {"type": "boolean", "default": false},
    "allowed_principals": {
      "type": "array",
      "maxItems": 500,
      "items": {"type": "string"},
      "default": []
    }
  },
  "additionalProperties": false
}
