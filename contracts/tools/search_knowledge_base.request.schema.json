{
  "$comment": "MCP search_knowledge_base argument schema (org-memory HTTP adapter).",
  "type": "object",
  "required": ["query"],
  "properties": {
    "query": {"type": "string", "minLength": 1},
    "source_type": {
      "type": "string",
      "enum": ["calendar_event", "slack_message", "notion_page"]
    },
    "author": {"type": "string"},
    "date_from": {"type": "string", "format": "date"},
    "date_to": {"type": "string", "format": "date"},
    "updated_from": {"type": "string", "format": "date"},
    "updated_to": {"type": "string", "format": "date"},
    "doc_id": {"type": "string"},
    "limit": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50},
    "half_life_days": {
      "type": "number",
      "minimum": 1,
      "maximum": 365,
      "default": 30
    },
    "min_decay": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.0}
  },
  "additionalProperties": false
}
