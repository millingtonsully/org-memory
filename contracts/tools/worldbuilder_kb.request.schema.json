{
  "$comment": "worldbuilder_kb arguments.",
  "type": "object",
  "properties": {
    "about": {"type": "string", "minLength": 1},
    "query": {"type": "string", "minLength": 1},
    "author": {"type": "string"},
    "author_canonical_entity_id": {"type": "string"},
    "source_type": {
      "type": "string",
      "description": "Opaque object-kind label (free string)."
    },
    "source_system": {
      "type": "string",
      "description": "Opaque connector/system id (free string)."
    },
    "mode": {
      "type": "string",
      "enum": ["hybrid", "semantic", "keyword"],
      "default": "hybrid"
    },
    "limit": {"type": "integer", "minimum": 1, "maximum": 25, "default": 10}
  },
  "anyOf": [
    {"required": ["about"]},
    {"required": ["query"]}
  ],
  "additionalProperties": false
}
