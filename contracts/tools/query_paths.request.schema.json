{
  "$comment": "MCP query_paths argument schema (deterministic multi-hop).",
  "type": "object",
  "required": ["start_type", "start_id"],
  "properties": {
    "start_type": {"type": "string", "minLength": 1},
    "start_id": {"type": "string", "minLength": 1},
    "relationship_types": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "max_depth": {"type": "integer", "minimum": 1, "maximum": 10, "default": 2},
    "limit": {"type": "integer", "minimum": 1, "maximum": 500, "default": 50},
    "as_of": {"type": "string", "format": "date-time"},
    "believed_as_of": {"type": "string", "format": "date-time"},
    "as_of_grain": {
      "type": "string",
      "enum": ["day", "month", "quarter", "year", "unknown"],
      "description": "World-time grain for as_of matching (month/quarter/year use calendar-bucket overlap)."
    }
  },
  "additionalProperties": false
}
