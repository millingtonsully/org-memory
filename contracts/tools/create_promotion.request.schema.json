{
  "$comment": "POST /v1/promotions request body (agent promote → OM claim + host taxonomy proposal). host_entity_id may be omitted; OM fills it from identity:platform_user when unambiguous.",
  "type": "object",
  "required": [
    "om_canonical_id",
    "taxonomy_key",
    "field_key",
    "value",
    "evidence_doc_ids"
  ],
  "properties": {
    "om_canonical_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "subject_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "default": "person"
    },
    "host_entity_id": {"type": "string", "maxLength": 500, "default": ""},
    "taxonomy_key": {"type": "string", "minLength": 1, "maxLength": 200},
    "field_key": {"type": "string", "minLength": 1, "maxLength": 200},
    "value": {"type": "string", "minLength": 1, "maxLength": 10000},
    "evidence_doc_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {"type": "string", "minLength": 1}
    },
    "source_kind": {"type": "string", "maxLength": 100, "default": ""},
    "source_id": {"type": "string", "maxLength": 500, "default": ""}
  },
  "additionalProperties": false
}
