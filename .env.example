# Org Memory — environment template
# Copy to .env and fill every required value. Boot fails fast if anything
# required is missing or invalid (see src/org_memory/core/settings.py).
#
# Required: unset values below with no default in Settings.
# Optional: commented examples; omit them to keep code defaults.

# --- Tenant & auth (required) ---
# One deployment serves one workspace.
WORKSPACE_ID=local-dev
# Root credential for callers. Treat as secret; rotate regularly.
SERVICE_API_KEY=replace-with-long-random-string

# --- Postgres (required) ---
# Must use the psycopg3 scheme exactly:
DATABASE_URL=postgresql+psycopg://orgmemory:orgmemory@localhost:5432/orgmemory

# --- Embeddings (required) ---
# Any OpenAI-compatible /embeddings host.
EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# Must match the schema vector() width (currently 1536).
EMBEDDING_DIMENSIONS=1536

# --- Rerank (required) ---
# Any Voyage-compatible /rerank host.
RERANK_API_KEY=
RERANK_API_URL=https://api.voyageai.com/v1
RERANK_MODEL=rerank-2.5

# --- Synthesis / chat (optional) ---
# If SYNTHESIS_API_KEY is blank, the embedding key is reused.
# SYNTHESIS_API_KEY=
# SYNTHESIS_API_URL=https://api.openai.com/v1
# SYNTHESIS_MODEL=gpt-4o-mini

# --- Explicit ops policy (required; no silent product defaults) ---
# 0 disables automatic purge. Legal holds still block deletion of held docs.
RETENTION_DAYS=365
# Soft alert threshold (tokens / calendar month).
SPEND_ALERT_TOKENS_MONTHLY=10000000
# Hard stop for new spend-incurring work. Must be >= alert threshold.
SPEND_HARD_LIMIT_TOKENS_MONTHLY=20000000

# --- Object store (required for chosen backend) ---
# Peers, not fallbacks: configure exactly one backend and its credentials.
OBJECT_STORE_BACKEND=supabase
SUPABASE_PROJECT_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=org-memory-blobs

# Production blobs on S3 / R2 / MinIO:
# OBJECT_STORE_BACKEND=s3
# S3_BUCKET_NAME=
# AWS_REGION=us-east-1
# S3_SSE=AES256
# S3_SSE_KMS_KEY_ID=          # required when S3_SSE=aws:kms
# S3_ENDPOINT_URL=            # S3-compatible only (forces path-style)
# S3_FORCE_PATH_STYLE=false
# S3_MULTIPART_THRESHOLD_BYTES=8388608
# AWS credentials: standard provider chain (env / profile / IAM role), not here.

# --- Retrieval / identity / taxonomy (optional; code defaults shown) ---
# RRF_K=60
# RERANK_CANDIDATES=100
# COLLABORATION_REBUILD_DEBOUNCE_SECONDS=60
# FACT_ACTIVATION_CONFIDENCE=0.8
# IDENTITY_CANDIDATE_SIMILARITY=0.88
# IDENTITY_CANDIDATE_LIMIT=3
# IDENTITY_MERGE_CONFIDENCE=0.95
# PROCEDURAL_MAX_SOURCE_CHARS=24000
# TAXONOMY_REGISTRY_DIR=config/taxonomy_registry
# TAXONOMY_PROPOSAL_WEBHOOK_URL=
